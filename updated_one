// Cache to avoid recomputing states
private final Set<String> btCache = new HashSet<>();
private int btCalls = 0;


// Entry function
public void solvePuzzleByBacktracking() {

    btCache.clear();
    btCalls = 0;

    List<Bridge> start = deepCopyBridges(bridges);

    List<Bridge> result = btSolve(start,0);

    if(result != null)
    {
        bridges.clear();
        bridges.addAll(result);
        repaint();

        JOptionPane.showMessageDialog(this,
                "Solution found using Backtracking\nCalls: " + btCalls);
    }
    else
    {
        JOptionPane.showMessageDialog(this,
                "No solution found");
    }
}


// Main recursive solver
private List<Bridge> btSolve(List<Bridge> current, int depth)
{
    btCalls++;

    if(btIsSolved(current))
        return current;

    if(!btIsValid(current))
        return null;

    if(depth > 60)
        return null;

    String key = btStateKey(current);

    if(btCache.contains(key))
        return null;

    List<int[]> moves = btMoves(current);

    for(int[] mv : moves)
    {
        Island a = islands.get(mv[0]);
        Island b = islands.get(mv[1]);

        List<Bridge> next = deepCopyBridges(current);

        Bridge ex = btFindBridge(a,b,next);

        if(ex == null)
            next.add(new Bridge(a,b,1));
        else if(ex.count < MAX_BRIDGES)
            ex.count++;
        else
            continue;

        List<Bridge> result = btSolve(next,depth+1);

        if(result != null)
            return result;
    }

    btCache.add(key);
    return null;
}


